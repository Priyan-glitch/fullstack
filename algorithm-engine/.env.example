# Copy this to .env and fill in values. Never commit .env.

APP_ENV=development
APP_PORT=8090

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/algorithm_db

RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_JOBS_QUEUE=allocation.jobs
RABBITMQ_RESULTS_QUEUE=allocation.results

REDIS_URL=redis://localhost:6379/0
