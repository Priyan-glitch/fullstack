# Copy this to .env and fill in values. Never commit .env.

APP_ENV=development
APP_PORT=8090

# Downstream microservices
STUDENT_SERVICE_URL=http://localhost:8081
HOSTEL_SERVICE_URL=http://localhost:8082

# PostgreSQL — stores allocation runs and groups
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/algorithm_db
