# Stable Roomies — API gateway (Caddy + JWT authentication)
#
# Development: runs on localhost:80, services on localhost ports.
# Docker:      service names resolve via Docker DNS (e.g. student-service:8081).
#
# Every upstream host is an env var whose default is the Docker service name.
# Compose needs to set nothing. To run the gateway on the host instead, point the
# hosts at localhost — otherwise these names do not resolve and every request
# fails with a 502 DNS error:
#
#   export AUTH_SERVICE_HOST=localhost STUDENT_SERVICE_HOST=localhost \
#          HOSTEL_SERVICE_HOST=localhost ALLOCATION_SERVICE_HOST=localhost \
#          NOTIFICATION_SERVICE_HOST=localhost ALGORITHM_ENGINE_HOST=localhost \
#          FRONTEND_HOST=localhost GATEWAY_PORT=8080
#
# scripts/dev-native.sh does exactly this.
#
# Authentication: every request under /api/* must carry a JWT issued by
# auth-service as `Authorization: Bearer <token>`. Tokens are HS256, signed with
# a secret shared with auth-service via JWT_SECRET, and verified locally here —
# no per-request round trip to the issuer.
#
# The only unauthenticated endpoints are POST /api/auth/login and
# POST /api/auth/register, which is where tokens come from in the first place.
#
# IMPORTANT: this gateway is only the enforcement point. The services still
# publish their own host ports, so they remain reachable directly and can be
# called without a token. Remove those port mappings to make the gateway the
# only way in — see the README.

{
	# jwtauth is a custom directive from the ggicci/caddy-jwt module, so it needs
	# an explicit position in the handler chain. Placing it before basicauth puts
	# it ahead of handle / reverse_proxy, i.e. the token is checked before any
	# request reaches a backend.
	order jwtauth before basicauth
}

# 8080 rather than 80 for host runs: binding below 1024 needs root on macOS and
# Linux. In Docker it keeps the default and is published as 80:80.
:{$GATEWAY_PORT:80} {

	encode gzip

	# `route` keeps the blocks below in source order. That matters: CORS has to be
	# answered before jwtauth, otherwise the preflight would come back 401 because
	# preflight requests never carry an Authorization header.
	route {

		# ── 1. CORS preflight — answered here, never authenticated ─────────────
		@preflight {
			method OPTIONS
			path /api/*
		}
		handle @preflight {
			header {
				Access-Control-Allow-Origin "{$CORS_ALLOW_ORIGIN:http://localhost:5173}"
				Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
				Access-Control-Allow-Headers "Authorization, Content-Type"
				Access-Control-Max-Age "600"
				Vary Origin
			}
			respond "" 204
		}

		# ── 2. Public auth endpoints ──────────────────────────────────────────
		# These two are where tokens come from, so they cannot require one. Matched
		# by method *and* path so nothing else slips through unauthenticated — in
		# particular /api/auth/me falls through to the block below and is checked.
		@publicAuth {
			method POST
			path /api/auth/login /api/auth/register
		}
		handle @publicAuth {
			# Still needs the CORS header, otherwise the browser discards the
			# response and a failed login looks like a network error.
			header {
				Access-Control-Allow-Origin "{$CORS_ALLOW_ORIGIN:http://localhost:5173}"
				Vary Origin
			}
			reverse_proxy {$AUTH_SERVICE_HOST:auth-service}:8085
		}

		# ── 3. Authenticated API surface ──────────────────────────────────────
		#
		# This is a matcher-scoped `route`, NOT a `handle`, and that distinction
		# is load-bearing. A `route` that sits as a *sibling* of nested `handle`
		# directives gets skipped by Caddy entirely — which silently disabled
		# both the token check and the role check, letting anonymous requests
		# through (verified: such a config proxied an unauthenticated request).
		# `route` also executes its directives in source order, which is what an
		# authenticate-then-authorize-then-proxy sequence requires. Everything
		# below is deliberately flat for the same reason.
		@api path /api/*
		route @api {

			# Set before jwtauth so the browser can still read a 401 body.
			header {
				Access-Control-Allow-Origin "{$CORS_ALLOW_ORIGIN:http://localhost:5173}"
				Vary Origin
			}

			jwtauth {
					# Shared secret with auth-service. Providing sign_key alone
					# would already imply HS256, but naming the algorithm keeps a
					# production swap (e.g. to RS256 + jwk_url) a one-line change.
					sign_alg HS256
					# Must be identical to auth-service's auth.jwt.secret, and
					# base64 — caddy-jwt decodes it into raw key bytes.
					sign_key {$JWT_SECRET:c3RhYmxlLXJvb21pZXMtZGV2LW9ubHktand0LXNlY3JldC0zMmI=}
					# Rejects tokens minted for a different issuer on the same
					# secret. `sub` populates {http.auth.user.id}.
					issuer_whitelist stable-roomies-auth
					user_claims sub
					# Populates {http.auth.user.role}, which the check below reads.
					# `user_claims` would NOT do this: that list only selects the
					# user *id*, so `role` there is an id fallback, not a mapping.
					meta_claims "role -> role"
					log_level debug
				}

				# ── Authorization ─────────────────────────────────────────────
				# A valid token proves who you are, not what you may do. Without
				# this, any signed-in student could list every student record,
				# read all submitted preferences, and trigger a campus-wide
				# allocation run.
				#
				# Only paths the student UI never calls are listed, so no student
				# feature depends on them. Student pages use /api/students/{id},
				# /api/students/email/*, /api/students/search,
				# /api/preferences/student/{id}, /api/allocations/student/{id}
				# and /api/room-type-config/available — none of which appear here.
				#
				# Fails closed: a missing role expands to "" and is rejected.
				@adminOnly {
					path /api/students /api/students/admin/* /api/preferences/submitted /api/dashboard/* /api/v1/allocation/* /api/allocation/trigger /api/room-type-config/sync /api/room-type-config/bulk
					expression `{http.auth.user.role} != "admin"`
				}
			respond @adminOnly "Administrator access required." 403

			# NOTE ON MATCHERS: every block below lists the collection root as
			# well as its descendants. `path /api/hostels/*` does NOT match
			# `/api/hostels`, so writing only the wildcard form makes
			# POST /api/hostels (create) return 404 while GET /api/hostels/1
			# works — an easy bug to miss, because the failing calls are exactly
			# the collection-level ones the UI uses to list and create.
			# `path` with several arguments ORs them.

			# ── Student service ───────────────────────────────────────────────
			# Student-facing allocation summary lives under /api/allocations/*
			# (plural). The engine-facing allocation API is /api/allocation/*
			# (singular) — a different segment, so the two do not overlap.
			@studentApi path \
				/api/students /api/students/* \
				/api/preferences /api/preferences/* \
				/api/allocations /api/allocations/*
			handle @studentApi {
				reverse_proxy {$STUDENT_SERVICE_HOST:student-service}:8081 {
					header_up X-Auth-User-Id {http.auth.user.id}
				}
			}

			# ── Allocation service ────────────────────────────────────────────
			@allocationApi path /api/allocation /api/allocation/*
			handle @allocationApi {
				reverse_proxy {$ALLOCATION_SERVICE_HOST:allocation-service}:8083 {
					header_up X-Auth-User-Id {http.auth.user.id}
				}
			}

			# ── Hostel service ────────────────────────────────────────────────
			# room-type-config is here too: it is a hostel-service controller and
			# was previously unrouted, so the room availability screen 404ed.
			@hostelApi path \
				/api/hostels /api/hostels/* \
				/api/rooms /api/rooms/* \
				/api/dashboard /api/dashboard/* \
				/api/room-type-config /api/room-type-config/*
			handle @hostelApi {
				reverse_proxy {$HOSTEL_SERVICE_HOST:hostel-service}:8082 {
					header_up X-Auth-User-Id {http.auth.user.id}
				}
			}

			# ── Notification service ──────────────────────────────────────────
			@notificationApi path /api/notifications /api/notifications/*
			handle @notificationApi {
				reverse_proxy {$NOTIFICATION_SERVICE_HOST:notification-service}:8084 {
					header_up X-Auth-User-Id {http.auth.user.id}
				}
			}

			# ── Auth service ──────────────────────────────────────────────────
			# Everything here except login/register needs a valid token, because
			# the public pair is matched earlier in this route. Keeping it behind
			# jwtauth is what stops /api/auth/me being callable anonymously.
			@authApi path /api/auth /api/auth/*
			handle @authApi {
				reverse_proxy {$AUTH_SERVICE_HOST:auth-service}:8085 {
					header_up X-Auth-User-Id {http.auth.user.id}
				}
			}

			# ── Algorithm engine ──────────────────────────────────────────────
			@engineApi path /api/v1/allocation /api/v1/allocation/*
			handle @engineApi {
				reverse_proxy {$ALGORITHM_ENGINE_HOST:algorithm-engine}:8090 {
					header_up X-Auth-User-Id {http.auth.user.id}
				}
			}

			# Any other /api/* path is a client mistake, not a page. Returning 404
			# here stops it falling through to the SPA and rendering the app shell.
			respond 404
		}

		# ── 4. Frontend (catch-all) ───────────────────────────────────────────
		handle {
			reverse_proxy {$FRONTEND_HOST:frontend}:80
		}
	}
}
