# Stable Roomies – Caddy Reverse Proxy / API Gateway
#
# Development: runs on localhost, services on localhost ports.
# Docker:      service names resolve via Docker DNS (e.g. student-service:8081).
#
# Replace :80 with your domain in production — Caddy handles TLS automatically.

:80 {

    # ── Student Service ───────────────────────────────────────────────────────
    handle /api/v1/students/* {
        reverse_proxy student-service:8081
    }

    handle /api/v1/preferences/* {
        reverse_proxy student-service:8081
    }

    # ── Hostel Service ────────────────────────────────────────────────────────
    handle /api/v1/hostels/* {
        reverse_proxy hostel-service:8082
    }

    handle /api/v1/rooms/* {
        reverse_proxy hostel-service:8082
    }

    # ── Allocation Service ────────────────────────────────────────────────────
    handle /api/v1/allocations/* {
        reverse_proxy allocation-service:8083
    }

    handle /api/v1/room-changes/* {
        reverse_proxy allocation-service:8083
    }

    # ── Notification Service ──────────────────────────────────────────────────
    handle /api/v1/notifications/* {
        reverse_proxy notification-service:8084
    }

    # ── Algorithm Engine (internal) ───────────────────────────────────────────
    handle /api/v1/algorithm/* {
        reverse_proxy algorithm-engine:8090
    }

    # ── Frontend (catch-all) ──────────────────────────────────────────────────
    handle /* {
        reverse_proxy frontend:80
    }

}
