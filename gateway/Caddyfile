# Stable Roomies – Caddy Reverse Proxy / API Gateway
#
# In development, Caddy runs on localhost:80 and routes traffic
# to each microservice by path prefix.
#
# In production, replace :80 with your domain (e.g. stableroomies.example.com)
# and Caddy will handle HTTPS/TLS automatically.

:80 {

    # ── Frontend ────────────────────────────────────────────────────────────
    # React dev server (Vite runs on 5173)
    handle /* {
        reverse_proxy localhost:5173
    }

    # ── Student Service ──────────────────────────────────────────────────────
    handle /api/v1/students/* {
        reverse_proxy localhost:8081
    }

    handle /api/v1/preferences/* {
        reverse_proxy localhost:8081
    }

    # ── Hostel Service ────────────────────────────────────────────────────────
    handle /api/v1/hostels/* {
        reverse_proxy localhost:8082
    }

    handle /api/v1/rooms/* {
        reverse_proxy localhost:8082
    }

    # ── Allocation Service ────────────────────────────────────────────────────
    handle /api/v1/allocations/* {
        reverse_proxy localhost:8083
    }

    handle /api/v1/room-changes/* {
        reverse_proxy localhost:8083
    }

    # ── Notification Service ──────────────────────────────────────────────────
    handle /api/v1/notifications/* {
        reverse_proxy localhost:8084
    }

    # ── Algorithm Engine (internal – not exposed publicly in production) ──────
    handle /api/v1/algorithm/* {
        reverse_proxy localhost:8090
    }

}
