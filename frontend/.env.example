# Copy to `.env.local` and fill in your own values.
# Vite only exposes variables prefixed with `VITE_` to client code.

# ── Clerk authentication (required) ───────────────────────────────────────────
# Find this in the Clerk dashboard → Configure → API keys (or Developers → API keys).
# Publishable keys are safe to commit/expose; secret keys are not.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_ZXhjaXRpbmctemVicmEtMTIzMS5jbGVyay5hY2NvdW50cy5kZXYk

# ── Optional: grant the admin (warden) role by email ──────────────────────────
# Comma-separated list. Overrides nothing in Clerk; used as a fallback when a
# user has no `role` value in their Clerk public metadata.
# VITE_ADMIN_EMAILS=warden@campus.edu,chief.warden@campus.edu

# ── Backend service URLs (optional — defaults in src/config/api.js) ───────────
# VITE_API_BASE_URL=http://localhost:8081
# VITE_HOSTEL_API_BASE_URL=http://localhost:8082
# VITE_ALLOCATION_SERVICE_URL=http://localhost:8083
# VITE_ALGORITHM_API_BASE_URL=http://localhost:8090
